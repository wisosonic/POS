{
  "name": "@pos/branch-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The branch server (docs/11-multi-branch.md §8): the one authority for a branch. Runs alone on a machine in the branch.",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && npm run typecheck --workspaces --if-present",
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "create-admin": "tsx src/cli/create-admin.ts",
    "backup": "tsx src/cli/backup.ts",
    "restore": "tsx src/cli/restore.ts",
    "etl": "tsx src/etl/cli.ts",
    "rehearse": "tsx src/cli/rehearse.ts",
    "preflight": "tsx src/cli/preflight.ts",
    "e2e-server": "tsx src/cli/e2e-server.ts",
    "typecheck:tests": "tsc -p tsconfig.tests.json",
    "test": "vitest run --project unit --project db",
    "test:unit": "vitest run --project unit",
    "test:db": "vitest run --project db",
    "test:integration": "vitest run --project integration --no-file-parallelism",
    "test:migration": "vitest run --project migration",
    "test:load": "tsx tests/load/run.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/jwt": "^10.2.5",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.6",
    "@node-rs/argon2": "^2.2.2",
    "@pos/core": "*",
    "@pos/shared": "*",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.12.7",
    "fastify-plugin": "^6.0.1",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.0.0",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.0",
    "supertest": "^7.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.18.0",
    "vitest": "^5.0.5"
  },
  "workspaces": [
    "core",
    "shared"
  ]
}
