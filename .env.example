# Copy to .env (never commit .env).
# SQLite database file. Must be on the till PC's own disk (not a network share). Only the API may write to it.
DATABASE_PATH=./data/pos.db
PORT=3000
HOST=127.0.0.1
# Set a real random value in production; generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
# Windows printer queue name for the USB receipt printer (M3). Leave empty to use browser print only.
PRINTER_NAME=

# Extra names the server answers to, comma separated (localhost, 127.0.0.1 and [::1] always work). Leave empty on the shop PC.
# Only for a tablet on a trusted network, and only once HTTPS is set up: see docs/08-security-review.md.
ALLOWED_HOSTS=

# The built web app (apps/web/dist), served by the API itself. Leave empty in development (Vite serves the app on :5173).
WEB_DIST=

# Where product pictures are kept. Leave empty to use an "uploads" folder beside the database.
UPLOADS_DIR=

# HTTPS, for a tablet or second PC on the shop's network (docs/07-operations.md). Both paths, or neither.
TLS_CERT=
TLS_KEY=

# Backups (docs/07-operations.md). Without BACKUP_DIR there are no automatic backups.
BACKUP_DIR=
# A second place for every backup: an external drive, or a folder that syncs offsite. A backup on the same disk does not survive the disk failing.
BACKUP_COPY_DIR=
# Encrypts the backups. At least 12 characters. WRITE IT DOWN somewhere safe: without it a backup cannot be restored.
BACKUP_PASSPHRASE=
# Shop-local time of the daily backup. If the PC was off then, it runs as soon as it is back on.
BACKUP_AT=02:00
# How many backups to keep in each folder.
BACKUP_KEEP=30
