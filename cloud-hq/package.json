{
  "name": "@pos/cloud-hq",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The cloud HQ server (docs/11-multi-branch.md §8, docs/12-sync-and-hq.md): knows every branch. Runs alone in the cloud.",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && npm run typecheck --workspaces --if-present",
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck:tests": "tsc -p tsconfig.tests.json",
    "test": "vitest run --project central --project unit",
    "test:central": "vitest run --project central",
    "test:unit": "vitest run --project unit",
    "test:system": "vitest run --project system --no-file-parallelism",
    "e2e": "playwright test",
    "e2e-server": "tsx src/cli/e2e-server.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "create-admin": "tsx src/cli/create-admin.ts",
    "backup": "tsx src/cli/backup.ts",
    "restore": "tsx src/cli/restore.ts",
    "build": "npm run build --prefix web"
  },
  "dependencies": {
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.12",
    "@node-rs/argon2": "^2.2.2",
    "@pos/core": "*",
    "@pos/shared": "*",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.12.7",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.65.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.0.0",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.0",
    "supertest": "^7.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.18.0",
    "vitest": "^5.0.5"
  },
  "workspaces": [
    "core",
    "shared",
    "web"
  ]
}
