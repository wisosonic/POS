{
  "name": "pos-new",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build -w @pos/web",
    "test": "vitest run --project unit --project db --project web",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration --no-file-parallelism",
    "test:migration": "vitest run --project migration",
    "test:e2e": "playwright test",
    "test:load": "tsx tests/load/run.ts",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "typecheck:tests": "tsc -p tsconfig.tests.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:db": "vitest run --project db",
    "test:web": "vitest run --project web",
    "dev": "node scripts/dev.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.0.0",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.0",
    "supertest": "^7.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.18.0",
    "vitest": "^5.0.5"
  }
}
